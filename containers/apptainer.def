# QuIDBBIDS Apptainer image based on full MATLAB, serving two use cases from one image:
#   - licensed: an interactive full MATLAB, e.g.
#       apptainer exec --env MLM_LICENSE_FILE=27000@your-license-server quidbbids.sif matlab
#   - license-free: the default %runscript runs the mcc-compiled standalone app; the MATLAB installation acts
#     as the runtime root (a MATLAB installation can replace the MATLAB Runtime), so no license is needed
#
# Run mode examples:
#   1. full MATLAB (licensed): opens a MATLAB command terminal; proceed as on your desktop
#      (docs/GUI.rst, docs/CLI.rst; the GUI needs an X display, e.g. ssh -X / xhost +)
#      apptainer exec --env MLM_LICENSE_FILE=27000@your-license-server \
#          --bind /data/bids:/data/bids quidbbids-v1.0.0.sif matlab
#   2a. compiled app, GUI (license-free, X11 forwarding over "ssh -X"; folder picker per docs/GUI.rst):
#       apptainer run --bind /data/bids:/data/bids quidbbids-v1.0.0.sif
#   2b. compiled app, CLI (license-free):
#       apptainer run --bind /data/bids:/data/bids quidbbids-v1.0.0.sif /data/bids \
#           --deliverables MWFmap,Chimap --configfile /data/bids/code/quidbbids_config.json
#
# Build (compiling with mcc needs a MATLAB license at build time):
# NB: Packages in containers/sepia/external are included as SEPIA dependencies (e.g.: 'SEGUE', 'MRISC' and 'STISuite',
#     i.e. named as the SpecifyToolboxesDirectory.m variables without the '_HOME' suffix)
#   export APPTAINERENV_MLM_LICENSE_FILE=27000@your-license-server
#   sudo -E apptainer build quidbbids-v1.0.0.sif containers/apptainer.def
#
# GPU workers (MCR_GPUWorker/R1R2starWorker): add --nv (NVIDIA driver); if CUDA libraries are missing, switch the
# base image to mathworks/matlab-deep-learning:r2026a

# ---- SynthStrip stage: mri_synthstrip (brain extraction) from the official SynthStrip image ----
Bootstrap: docker
From: freesurfer/synthstrip:latest
Stage: synthstrip

Bootstrap: docker
From: mathworks/matlab:r2026a

%help
      ___       ___ ___  ___ ___ ___ ___  ___
     / _ \ _  _|_ _|   \| _ ) _ )_ _|   \/ __|
    | (_) | || || || |) | _ \ _ \| || |) \__ \
     \__\_\\_,_|___|___/|___/___/___|___/|___/
    
    Quantitative Imaging Derived Biomarkers in BIDS
    ‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾‾
    QuIDBBIDS container image with a full MATLAB installation and the mcc-compiled QuIDBBIDS app,
    serving two run modes: full MATLAB (licensed at run time via MLM_LICENSE_FILE) or the compiled
    app (license-free). Run mode examples:

    1. full MATLAB (licensed): MATLAB command terminal; proceed as on your desktop (docs/GUI.rst,
       docs/CLI.rst; the GUI needs an X display, e.g. ssh -X / xhost +)
       apptainer exec --env MLM_LICENSE_FILE=27000@your-license-server \
           --bind /data/bids:/data/bids quidbbids.sif matlab
    2a. compiled app, GUI (license-free, X11 forwarding):
       apptainer run --bind /data/bids:/data/bids quidbbids.sif
    2b. compiled app, CLI (license-free):
       apptainer run --bind /data/bids:/data/bids quidbbids.sif /data/bids \
           --deliverables MWFmap,Chimap --configfile /data/bids/code/quidbbids_config.json

    See https://quidbbids.readthedocs.io/en/latest/containers.html for all options and examples

%files from synthstrip
    /freesurfer /freesurfer
    /usr/local /usr/local

%files
    containers/sepia/external /opt/sepia-external

%environment
    export SEPIA_TOOLBOXES=/opt/quidbbids/dependencies/sepia/external
    export FREESURFER_HOME=/freesurfer
    export PATH=/freesurfer:${PATH}
    export PYTHONUSERBASE=/freesurfer/env

%post
    set -e

    # sudo -E leaks the host HOME, which doesn't exist here; MATLAB needs a writable HOME
    export HOME=/root
    deps=/opt/quidbbids/dependencies

    # ---- 1. Clone QuIDBBIDS (the MATLAB dependencies come along as git submodules) ----
    # MLM_LICENSE_FILE is passed in via APPTAINERENV_MLM_LICENSE_FILE at build time
    apt-get update && apt-get install -y --no-install-recommends git fonts-noto-color-emoji fonts-noto-core
    git clone --recurse-submodules --depth 1 https://github.com/Donders-Institute/quidbbids.git /opt/quidbbids

    # ---- 2. SEPIA: point SpecifyToolboxesDirectory.m to the copied and submodule toolboxes ----
    mv /opt/sepia-external $deps/sepia/external
    cp $deps/sepia/SpecifyToolboxesDirectory.template.m $deps/sepia/SpecifyToolboxesDirectory.m
    sed -i -E -e "s|^([A-Za-z]+)_HOME *= .*|\1_HOME = '$deps/sepia/external/\1/';|" \
              -e "s|^FANSI_HOME *= .*|FANSI_HOME = '$deps/FANSI_toolbox/';|" \
              -e "s|^MEDI_HOME *= .*|MEDI_HOME = '$deps/MEDI_toolbox/';|" \
              -e "s|^MRITOOLS_HOME *= .*|MRITOOLS_HOME = '$deps/sepia/external/MRITOOLS/';|" \
              $deps/sepia/SpecifyToolboxesDirectory.m

    # ---- 3. CompileMRI's prebuilt mritools bundle (ROMEO, CLEAR-SWI, ...); MRITOOLS_HOME points here ----
    COMPILEMRI_VERSION=4.9.1
    wget -q "https://github.com/korbinian90/CompileMRI.jl/releases/download/v$COMPILEMRI_VERSION/"\
"mritools_linux_x64_$COMPILEMRI_VERSION.tar.gz" -O /tmp/mritools.tar.gz
    mkdir -p $deps/sepia/external/MRITOOLS
    tar -xzf /tmp/mritools.tar.gz -C $deps/sepia/external/MRITOOLS --strip-components=1
    rm /tmp/mritools.tar.gz

    # Set external toolboxes that are not installed to empty, so SEPIA skips them without warnings
    for var in $(sed -n "s/^\([A-Za-z]*_HOME\) *=.*/\1/p" $deps/sepia/SpecifyToolboxesDirectory.m); do
        path=$(sed -n "s/^$var *= *'\([^']*\)'.*/\1/p" $deps/sepia/SpecifyToolboxesDirectory.m)
        if [ -n "$path" ] && [ ! -d "$path" ]; then
            sed -i "s|^$var *= .*|$var = [];|" $deps/sepia/SpecifyToolboxesDirectory.m
        fi
    done

    # ---- 4. Compile the standalone app with mcc ----
    wget -q https://www.mathworks.com/mpm/glnxa64/mpm -O /tmp/mpm && chmod +x /tmp/mpm
    MATLAB_ROOT="$(dirname "$(dirname "$(readlink -f "$(command -v matlab)")")")"
    /tmp/mpm install --matlabroot "$MATLAB_ROOT" --release "$(basename "$MATLAB_ROOT")" \
        --products MATLAB_Compiler && rm /tmp/mpm
    # -a bundles +qb, project.json and each top-level dependency dir (bundling every subdir makes the
    # deployed app crash at startup). Workers are instantiated dynamically (str2func) and invisible to
    # mcc's static analysis. NB: mcc emits build/quidbbids AND build/run_quidbbids.sh (generated, not in repo)
    # remove non-code .m files that mcc cannot parse (text readme/changelog/script files)
    rm -f "$deps/EPG-X/Additional_bSSFPX_CEST.m" "$deps/MEDI_toolbox/README.m" "$deps/MEDI_toolbox/UPDATES.m"
    rm -f "$deps/FANSI_toolbox"/script_*.m                  # Demo scripts with syntax mcc cannot parse
    rm -rf "$deps/spm/external" "$deps/spm/toolbox"         # Huge, not needed
    find "$deps/sepia/external" -name sfb3D_A.m -delete     # STI Suite HTML 404 page misnamed .m, breaks mcc
    cd /opt/quidbbids/containers
    matlab -batch "addpath('/opt/quidbbids', '/opt/quidbbids/containers'), \
    a = {'-m','quidbbids_mcr','-o','quidbbids','-d','/opt/quidbbids/containers/build','-v', \
         '-a','/opt/quidbbids/+qb','-a','/opt/quidbbids/project.json'}; \
    for d = fullfile('$deps', setdiff({dir('$deps').name}, {'.', '..'})), \
        a(end+1:end+2) = {'-a', char(d)}; \
    end, \
    mcc(a{:})"
    test -f /opt/quidbbids/containers/build/run_quidbbids.sh    # Fail the build if mcc did not complete

    # ---- 5. MRtrix3 (DWIprepWorker calls fod2fixel/fixel2voxel/fixel2peaks via system()) ----
    apt-get install -y --no-install-recommends mrtrix3 && apt-get clean && rm -rf /var/lib/apt/lists/*

    # ---- 6. HD-BET (brain extraction via pip; alternative to mri_synthstrip, see docs/installation.rst) ----
    pip install --break-system-packages --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
    pip install --break-system-packages --no-cache-dir hd-bet

%runscript
    MATLAB_ROOT="$(dirname "$(dirname "$(readlink -f "$(command -v matlab)")")")"
    exec /opt/quidbbids/containers/build/run_quidbbids.sh "$MATLAB_ROOT" "$@"
